# 复制为 .env.local，在本机填写。使用 NAME=值，不加引号。
# 已由部署进程注入的值优先。运行启动脚本时载入本文件。
ACCEPTANCE_RUST_PORT=
ACCEPTANCE_RUST_DATA=
CITYLINE_CONTEST_TARIFF=
CITYLINE_PUBLIC_ORIGIN=

# 新云地址使用加密协议，只填协议、主机及端口。以下路径取自授权资料。
CITYLINE_NEWCLOUD_ORIGIN=
# 可由部署进程注入已授权的会话，留空时由操作员在 Edge 登录。
CITYLINE_NEWCLOUD_SESSION=
CITYLINE_NEWCLOUD_LOGIN=
CITYLINE_NEWCLOUD_LANDING=
CITYLINE_NEWCLOUD_READY_MARKER=
CITYLINE_NEWCLOUD_GEOCODE=
CITYLINE_NEWCLOUD_COVERAGE=
CITYLINE_NEWCLOUD_COVERAGE_PAGE=
CITYLINE_NEWCLOUD_ROUTES=
CITYLINE_NEWCLOUD_GEOMETRY=
CITYLINE_NEWCLOUD_RENDERER=
CITYLINE_NEWCLOUD_MAP_SCRIPT=
CITYLINE_NEWCLOUD_LABEL_GROUPS=
CITYLINE_NEWCLOUD_LABELS=
CITYLINE_NEWCLOUD_LABEL_PAGE=
CITYLINE_NEWCLOUD_REACH=
CITYLINE_NEWCLOUD_REACH_PAGE=
# 可限制新云历史查询月份。按 2023-MM 填写，多个用英文逗号分隔。留空自动查询各采购段对应月，缺项再查 2023-05 基准。
CITYLINE_NEWCLOUD_REACH_MONTHS=
CITYLINE_NEWCLOUD_CENTER_COORDINATES=

# 红豆地址使用加密协议，只填协议、主机及端口。
# 接口前缀与各接口路径分别填写。库存授权令牌按需通过部署进程注入。
CITYLINE_REDBEAN_ORIGIN=
CITYLINE_REDBEAN_LOGIN=
CITYLINE_REDBEAN_API_PREFIX=
CITYLINE_REDBEAN_DICTIONARY=
CITYLINE_REDBEAN_BUS_PAGE=
CITYLINE_REDBEAN_METRO_PAGE=
CITYLINE_REDBEAN_BUS_EXPORT=
CITYLINE_REDBEAN_METRO_EXPORT=
CITYLINE_REDBEAN_SPECS=
CITYLINE_REDBEAN_OAUTH_ENDPOINT=
CITYLINE_REDBEAN_OAUTH_CLIENT_ID=
CITYLINE_REDBEAN_OAUTH_CLIENT_SECRET=
# 预存账号由服务端自动授权。Windows 可从本机加密文件读取密码。
CITYLINE_REDBEAN_USERNAME=
CITYLINE_REDBEAN_PASSWORD=
CITYLINE_REDBEAN_ACCESS_TOKEN=
CITYLINE_REDBEAN_TENANT_ID=

# 配置模型时填写模型服务地址。凭据优先从进程环境或本机加密文件读取。
ACCEPTANCE_RUST_MEDIA_MODEL_URL=
ACCEPTANCE_RUST_MEDIA_MODEL=
ACCEPTANCE_RUST_MEDIA_MODEL_KEY=
ACCEPTANCE_RUST_MEDIA_MODEL_REMOTE=
CITYLINE_AGENT_API_KEY_ENDPOINT=
CITYLINE_AGENT_API_KEY=

# 企业身份认证。开放身份连接及飞书所需凭据由部署环境提供。
CITYLINE_OIDC_ISSUER=
CITYLINE_OIDC_CLIENT_ID=
CITYLINE_OIDC_CLIENT_SECRET=
CITYLINE_OIDC_SUBJECTS=
CITYLINE_OIDC_ADMINS=
CITYLINE_OIDC_CA_FILE=
CITYLINE_FEISHU_AUTHORIZE_ENDPOINT=
CITYLINE_FEISHU_TOKEN_ENDPOINT=
CITYLINE_FEISHU_PROFILE_ENDPOINT=
CITYLINE_FEISHU_APP_ID=
CITYLINE_FEISHU_APP_SECRET=
CITYLINE_FEISHU_OPEN_IDS=
CITYLINE_FEISHU_ADMINS=
CITYLINE_FEISHU_CA_FILE=
